# Bats ephemeral test data
.bats-tmp/

# Python bytecode（harness/ 等）
__pycache__/
*.pyc

# L2 runtime-test scratch space (probe + L2 real-run artifacts: stdout NDJSON,
# logs, bats TMPDIR).
#
# The previous entry `$BATS_TEST_TMPDIR/` was ineffective and has been removed:
# .gitignore does NOT expand environment variables — it only matches a path
# whose literal name is `$BATS_TEST_TMPDIR`. The real knob is the `TMPDIR`
# environment variable (bats-core sets `BATS_TMPDIR="${TMPDIR:-/tmp}"` and
# derives BATS_TEST_TMPDIR from it), so the directory to ignore is a fixed path.
.tmp-l2/

# 双 session 运行时状态（活的 session id / pair 登记表，非版本化）
# ⚠ 放行 planner 的路线图 / 改进草稿与 architect 配置（它们是版本化工件）
.rddf/*
!.rddf/roadmap/
!.rddf/improvements/
!.rddf/config/

# subagent 输入契约运行时测试的 scratch 空间（hermetic HOME / NDJSON / 契约日志）
.tmp-sc/

# oracle 意图闸门运行时测试的 scratch 空间（fixture 工程 / NDJSON / 报告草稿）
.tmp-oig/
.tmp-oig-fixtures/

# 独立会话 e2e 的 scratch 产物（NDJSON / log / fixture）
.tmp-ibs/

# 角色感知写门 / 角色租约的运行时 e2e 的 scratch 产物（role-gate 探针 NDJSON / log / fixture）
.tmp-rg/

# commit 验证门运行时 e2e 的 scratch 空间（NDJSON / log / fixture）
.tmp-cg/

# push-gate 运行时 e2e 的 scratch 空间（NDJSON / log / fixture）
.tmp-pg/
.tmp-pg-fixtures/
.tmp-pt1/
.tmp-pt1-fixtures/
